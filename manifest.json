{
  "manifest_version": 3,
  "name": "DualSub for YouTube & Netflix",  
  "version": "1.0.0",
  "description": "Show two subtitle languages at the same time on YouTube and Netflix.",
  "browser_specific_settings": {
  "gecko": {
    "id": "a7Xk9-Q2m.v_L4@node-3.cluster_us1",
    "data_collection_permissions": {
      "required": [
        "websiteActivity","websiteContent","browsingActivity"
      ]
    },
    "strict_min_version": "140.0"
  }
},
  "permissions": ["storage"],
  "action": {
    "default_title": "DualSub",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.netflix.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.youtube.com/*", "*://*.netflix.com/*"],
      "js": ["shared.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}

